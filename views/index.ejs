    <!-- Modales personalizados para cada producto del día -->
    <% if (!entrenando && productos_hoy && productos_hoy.length > 0) { %>
    <% productos_hoy.forEach(function(prod, index) { %>
        <div id="modalHoy<%= index %>" class="modal_efectivo">
        <div class="modal-content_efectivo">
            <span class="close_changedolar" onclick="cerrarModalHoy(<%= index %>)">&times;</span>
            <p><strong><%= prod.ProductoNombre %></strong> - Proyección HOY: <%= Number.parseFloat(prod.VentasHoy || 0).toFixed(2) %> lbs</p>

            <div class="form-group col-sm-6">
            <label for="fechaInicioHoy<%= index %>">Fecha inicio</label>
            <input type="date" id="fechaInicioHoy<%= index %>" class="form-control form-control-sm">
            </div>

            <div class="form-group col-sm-6">
            <label for="fechaFinHoy<%= index %>">Fecha fin</label>
            <input type="date" id="fechaFinHoy<%= index %>" class="form-control form-control-sm">
            </div>

            <div class="form-group col-sm-6 mt-3">
            <button class="btn btn-success btn-sm btn-block"
                onclick="compararVentasHoy(<%= index %>, '<%= prod.ProductoNombre %>', <%= Number.parseFloat(prod.VentasHoy || 0) %>)">
                Mostrar comparación
            </button>
            </div>

            <ul id="resultadoHoy<%= index %>" class="list-group mt-3"></ul>
        </div>
        </div>
    <% }) %>
    <% } %>


    <!-- Modales dinámicos -->
    <% if (typeof semanasProyectadas !== 'undefined' && semanasProyectadas.length > 0) { %>
    <% semanasProyectadas.forEach(function(semana, index) { %>
        <div class="modal fade" id="modalSemana<%= index %>" tabindex="-1" aria-labelledby="modalSemanaLabel<%= index %>" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSemanaLabel<%= index %>"><%= semana.semana %> - Detalles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <canvas id="chartSemana<%= index %>"></canvas>
            </div>
            </div>
        </div>
        </div>

        <script>
        const labelsSemana<%= index %> = <%- JSON.stringify(semana.productos.map(p => p.ProductoNombre)) %>;
        const dataSemana<%= index %> = <%- JSON.stringify(
            semana.productos
            .sort((a,b) => b.VentasSemana - a.VentasSemana) // orden descendente
            .map(p => Number.parseFloat(p.VentasSemana || 0))
        ) %>;

        const ctxSemana<%= index %> = document.getElementById('chartSemana<%= index %>').getContext('2d');
        new Chart(ctxSemana<%= index %>, {
            type: 'bar',
            data: {
            labels: labelsSemana<%= index %>,
            datasets: [{
                label: 'Proyección (libras)',
                data: dataSemana<%= index %>,
                backgroundColor: 'rgba(75, 192, 192, 0.6)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1
            }]
            },
            options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                title: { display: true, text: 'Productos más proyectados' }
            },
            scales: {
                y: { beginAtZero: true }
            }
            }
        });
        </script>
    <% }) %>
    <% } %>

    <script>
        (function () {
        // --- Verificar soporte SSE ---
        if (typeof EventSource === 'undefined') {
            console.warn('EventSource no está disponible en este navegador.');
        }

        // --- Conexión SSE principal ---
        const evtSource = new EventSource('/progress');
        console.log("🔌 Conectado al SSE /progress");

        let modalVisible = false;
        let completed = false;

        function finalizarProceso() {
            if (completed) return;
            completed = true;
            console.log('✅ Finalizando proceso: cerrando modal y actualizando dashboard');

            const loadingModal = document.getElementById('loadingModal');
            if (loadingModal) loadingModal.style.display = 'none';

            try { evtSource.close(); } catch (e) { console.warn('Error cerrando SSE', e); }

            modalVisible = false;

            fetch('/predicciones')
            .then(res => res.json())
            .then(data => {
                // Aceptar distintos nombres que pueda devolver el backend
                const hoy = data.productos_hoy || data.hoy || [];
                const semanas = data.semanasProyectadas || data.productos_semana || data.semanas || [];

                // Llamadas defensivas: sólo si las funciones están definidas
                if (typeof window.renderProyeccionesDia === 'function') {
                window.renderProyeccionesDia(hoy);
                }
                if (typeof window.renderProyeccionesSemana === 'function') {
                window.renderProyeccionesSemana(semanas);
                }
            })
            .catch(err => console.error('❌ Error al cargar proyecciones:', err));
        }

        evtSource.onmessage = function (event) {
            const msg = (event.data || '').trim();
            console.log("📩 Mensaje SSE recibido:", msg);

            // PROGRESO
            if (msg.startsWith('PROGRESO:')) {
            const porcentaje = msg.slice('PROGRESO:'.length).trim();
            const progressText = document.getElementById('progressText');
            if (progressText) progressText.innerText = `Estamos analizando tus ventas (${porcentaje})...`;

            if (!modalVisible) {
                const loadingModal = document.getElementById('loadingModal');
                if (loadingModal) loadingModal.style.display = 'flex';
                modalVisible = true;
            }

            if (!completed && porcentaje === '100%') finalizarProceso();
            }

            // ESTADO
            if (msg.startsWith('ESTADO:')) {
            const estado = msg.slice('ESTADO:'.length).trim();
            if (estado.includes("YA_ENTRENADO")) finalizarProceso();

            let friendlyMessage = "Estamos analizando tus ventas anteriores...";
            if (estado.includes("Entrenando modelo diario")) friendlyMessage = "Preparando predicciones diarias de tus productos...";
            else if (estado.includes("Entrenando modelo semanal")) friendlyMessage = "Calculando tendencias semanales de tu negocio...";
            else if (estado.includes("global")) friendlyMessage = "Generando visión general de toda la carnicería...";

            const progressText = document.getElementById('progressText');
            if (progressText) progressText.innerText = friendlyMessage;

            if (!modalVisible) {
                const loadingModal = document.getElementById('loadingModal');
                if (loadingModal) loadingModal.style.display = 'flex';
                modalVisible = true;
            }
            }

            // ERROR
            if (msg.startsWith('ERROR:')) {
            const progressText = document.getElementById('progressText');
            if (progressText) progressText.innerText = '🕐Nos está tomando un tiempo';
            if (!modalVisible) {
                const loadingModal = document.getElementById('loadingModal');
                if (loadingModal) loadingModal.style.display = 'flex';
                modalVisible = true;
            }
            }
        };

        // --- Funciones de modal (si no existen en otro script) ---
        window.abrirModalHoy = window.abrirModalHoy || function (index) {
            const el = document.getElementById('modalHoy' + index);
            if (el) el.style.display = 'block';
            else console.warn('abrirModalHoy: modal no encontrado modalHoy' + index);
        };

        window.cerrarModalHoy = window.cerrarModalHoy || function (index) {
            const el = document.getElementById('modalHoy' + index);
            if (el) el.style.display = 'none';
            else console.warn('cerrarModalHoy: modal no encontrado modalHoy' + index);
        };

        // --- Render Día (expuesto globalmente) ---
        function renderProyeccionesDia(productos) {
            const tbody = document.querySelector('#tbventa tbody');
            const totalHoy = document.getElementById('totalHoy');
            if (!tbody || !totalHoy) {
            console.warn('renderProyeccionesDia: faltan #tbventa tbody o #totalHoy en el DOM.');
            return;
            }

            tbody.innerHTML = '';
            let total = 0;

            (Array.isArray(productos) ? productos : []).forEach((prod, index) => {
            const proy = Number.parseFloat(prod?.VentasHoy ?? 0);
            total += isNaN(proy) ? 0 : proy;

            const row = `
                <tr>
                <td>${prod?.ProductoNombre ?? '—'}</td>
                <td>${(isNaN(proy) ? 0 : proy).toFixed(2)}</td>
                <td>
                    <button class="btn btn-sm btn-primary" onclick="abrirModalHoy(${index})">
                    Ver detalles
                    </button>
                </td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', row);
            });

            totalHoy.innerText = `Total proyectado HOY: ${total.toFixed(2)} libras`;
        }

        // --- Render Semana (acepta varios formatos) ---
        function renderProyeccionesSemana(data) {
            const ul = document.getElementById('listaSemanas');
            const totalEl = document.getElementById('totalSemana');
            if (!ul || !totalEl) {
            console.warn('renderProyeccionesSemana: faltan #listaSemanas o #totalSemana en el DOM.');
            return;
            }

            ul.innerHTML = '';

            if (!Array.isArray(data) || data.length === 0) {
            ul.innerHTML = '<li class="list-group-item">No hay proyecciones semanales disponibles</li>';
            totalEl.innerText = 'Total proyectado SEMANA: 0 libras';
            return;
            }

            const first = data[0];
            let total = 0;

            if (first && Object.prototype.hasOwnProperty.call(first, 'semana')) {
            // Formato: [{ semana, totalLibras }, ...]
            data.forEach(s => {
                const val = Number.parseFloat(s?.totalLibras ?? 0);
                total += isNaN(val) ? 0 : val;
                ul.insertAdjacentHTML('beforeend', `
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                    <strong>${s?.semana ?? '—'}</strong><br>
                    <small>Total proyectado: ${(isNaN(val) ? 0 : val).toFixed(2)} lbs</small>
                    </div>
                </li>
                `);
            });
            } else if (first && (Object.prototype.hasOwnProperty.call(first, 'ProductoNombre') || Object.prototype.hasOwnProperty.call(first, 'VentasSemana'))) {
            // Formato: [{ ProductoNombre, VentasSemana }, ...]
            data.forEach(p => {
                const val = Number.parseFloat(p?.VentasSemana ?? 0);
                total += isNaN(val) ? 0 : val;
                ul.insertAdjacentHTML('beforeend', `
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                    <strong>${p?.ProductoNombre ?? '—'}</strong><br>
                    <small>Proyección semanal: ${(isNaN(val) ? 0 : val).toFixed(2)} lbs</small>
                    </div>
                </li>
                `);
            });
            } else {
            // Formato desconocido: mostrar JSON legible
            data.forEach(item => {
                ul.insertAdjacentHTML('beforeend', `<li class="list-group-item"><pre style="margin:0">${JSON.stringify(item)}</pre></li>`);
            });
            }

            totalEl.innerText = `Total proyectado SEMANA: ${total.toFixed(2)} libras`;
        }

        // Exponer funciones al ámbito global
        window.renderProyeccionesDia = renderProyeccionesDia;
        window.renderProyeccionesSemana = renderProyeccionesSemana;

        // --- Inicialización segura: pedir predicciones al cargar si la card existe ---
        document.addEventListener('DOMContentLoaded', () => {
            // Sólo pedir si la vista tiene los elementos donde pintar
            const hasDia = document.querySelector('#tbventa tbody') && document.getElementById('totalHoy');
            const hasSemana = document.getElementById('listaSemanas') && document.getElementById('totalSemana');

            // Si no hay ninguno, no hacemos fetch inicial (evita errores en otras páginas)
            if (!hasDia && !hasSemana) return;

            fetch('/predicciones')
            .then(r => r.json())
            .then(data => {
                if (hasDia) window.renderProyeccionesDia(data.productos_hoy || data.hoy || []);
                if (hasSemana) {
                const semanas = data.semanasProyectadas || data.productos_semana || data.semanas || [];
                window.renderProyeccionesSemana(semanas);
                }
            })
            .catch(err => console.error('❌ Error al cargar proyecciones iniciales:', err));
        });
        })();
    </script>



    <script>
        function abrirModalHoy(index) {
            document.getElementById('modalHoy' + index).style.display = 'block';
        }

        function cerrarModalHoy(index) {
            document.getElementById('modalHoy' + index).style.display = 'none';
        }
    </script>



    <script>
    async function compararVentasHoy(index, producto, proyeccionHoy) {
        const inicio = document.getElementById('fechaInicioHoy' + index).value;
        const fin = document.getElementById('fechaFinHoy' + index).value;
        const resultado = document.getElementById('resultadoHoy' + index);
        resultado.innerHTML = '<li class="list-group-item text-center">Cargando comparación...</li>';

        try {
        const res = await fetch(`/api/comparacion?producto=${encodeURIComponent(producto)}&inicio=${inicio}&fin=${fin}`);
        const data = await res.json();

        if (!data || data.length === 0) {
            resultado.innerHTML = '<li class="list-group-item">No hay datos disponibles en ese rango</li>';
            return;
        }

        resultado.innerHTML = '';
        data.forEach(item => {
            const tasa = proyeccionHoy > 0 ? ((item.cantidadVendida / proyeccionHoy) * 100).toFixed(2) : '0.00';
            resultado.innerHTML += `
            <li class="list-group-item">
                <strong>${item.fecha}</strong><br>
                Producto: ${item.producto}<br>
                Vendido: ${item.cantidadVendida.toFixed(2)} lbs<br>
                Crecimiento: ${tasa}%
            </li>
            `;
        });
        } catch (err) {
        resultado.innerHTML = '<li class="list-group-item text-danger">Error al cargar comparación</li>';
        console.error(err);
        }
    }
    </script>



