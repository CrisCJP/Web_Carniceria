                                            <% productos_hoy.forEach(function(prod, index) { %>
                                            <tr class="dataenvoice_styles">
                                                <td><%= prod.ProductoNombre %></td>
                                                <td><%= Number.parseFloat(prod.VentasHoy || 0).toFixed(2) %></td>
                                                <td>
                                                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalHoy<%= index %>">
                                                    Ver detalles
                                                </button>
                                                </td>
                                            </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                            <td colspan="3">No hay proyecciones disponibles para hoy</td>
                                            </tr>
                                        <% } %>
                                        </tbody>
                                    </table>

