                        <input type="number" id="inputEfectivo" class="form-control form-control-sm" placeholder="Cantidad en efectivo" min="1">
                    </div>
                    
                    <div class="form-group col-sm-6">
                        <button id="submitEfectivo" class="btn btn-success btn-sm btn-block">Enviar</button>
                    </div>
                </div>
            </div>
            
