<script>
  function probarProgressXHR() {
    const xhr = new XMLHttpRequest();
    xhr.open("GET", "/progress", true);

    xhr.onreadystatechange = function() {
      if (xhr.readyState === 3) { // mientras la conexión está abierta
        console.log("📩 [XHR parcial] Recibido:", xhr.responseText);
      }
      if (xhr.readyState === 4) { // cuando termina
        console.log("✅ [XHR completo] Respuesta final:", xhr.responseText);
      }
    };

    xhr.send();
  }

  // Ejecutar la prueba al cargar la página
  probarProgressXHR();
</script>


