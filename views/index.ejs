                                        <strong>Total proyectado HOY:</strong>
                                        <%= productos_hoy.reduce((sum, p) => sum + Number.parseFloat(p.VentasHoy || 0), 0).toFixed(2) %> libras
                                        <% } else { %>
                                        <strong>Total proyectado HOY:</strong> 0 libras
                                        <% } %>
                                    </div>
