        function limpiarCadena(cadena) {
            return cadena.replace(/\s+/g, '').split('-')[0];
        }

        function getUnidadMedida(Producto){
            var formData = new FormData();

            formData.append('Producto', Producto);

            var xhr = new XMLHttpRequest();
            xhr.open('post', '/getmedida', true);
            xhr.onload = function() {
                if (xhr.status === 200) {
                    var answer = JSON.parse(xhr.responseText);
                    if(answer.categoria){
                        var labelcantidad = document.getElementById('LabelCantidadAComprar');
                        if(parseInt(answer.categoria)==1){
                            labelcantidad.textContent = 'Unidad/es'
                        }else{
                            labelcantidad.textContent = 'Libra/s'
                        }
                        return parseInt(answer.categoria)
                    }else{
                        alert('no return product')
                        return 0
                    }
                } else {
                    console.log("Error al agregar producto");
                }
            };
            xhr.send(formData);
        }

        function optionProduct(){
            var datalist2 = document.getElementById('datalistOptions');
            var proveedor = limpiarCadena(document.getElementById('txtDocumentoProveedor').value);

            datalist2.innerHTML = '';

            var formData = new FormData();

            formData.append('txtDocumentoProveedor', proveedor);

            var xhr = new XMLHttpRequest();
            xhr.open('post', '/option2', true);
            xhr.onload = function() {
                if (xhr.status === 200) {
                    
                    // Analiza la respuesta JSON del servidor
                    var answer = JSON.parse(xhr.responseText);
                    
                    // Asegúrate de que la respuesta contiene el arreglo de productos
                    if (answer.idproducto && answer.nombreproducto) {
                        var Idproducto = answer.idproducto;
                        var producto = answer.nombreproducto;
                        // Iterar sobre los productos y crear una opción para cada uno
                        for(let i=0;i<producto.length;i++){
                            var option = document.createElement('option');
                            option.value = Idproducto[i]+' - '+producto[i];
                            datalist2.appendChild(option);
                        }
                    } else {
                        // Maneja el caso en que no hay productos
                        console.log('No hay productos para mostrar.');
                    }
                    
                } else {
                    console.log("Error al agregar producto");
                }
            };
            xhr.send(formData);
            
        }

        function establecerValoresEnFila(tablaId, indiceFila, valores) {
            var tabla = document.getElementById(tablaId);
            var fila = tabla.getElementsByTagName('tbody')[0].getElementsByTagName('tr')[indiceFila];

            if (fila) {
                var celdas = fila.getElementsByTagName('td');
                for (var i = 0; i < 5; i++) {
                    if (celdas[i]) {
                        celdas[i].innerText = valores[i];
                    }
                }
            } else {
                console.error("Fila no encontrada en el índice especificado.");
            }
        }

        function obtenerFilaConValor(tablaId, indiceColumna, valorBuscado) {
            // Obtener la tabla por ID
            var tabla = document.getElementById(tablaId);
            var filas = tabla.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            // Recorrer las filas de la tabla
            for (var i = 0; i < filas.length; i++) {
                var celdas = filas[i].getElementsByTagName('td');
                // Verificar si el valor en la columna especificada coincide con el valor buscado
                if (celdas[indiceColumna].innerText.trim() === valorBuscado) {
                    return i; // Retornar el índice de la fila donde se encontró el valor
                }
            }
            return -1; // Valor no encontrado
        }

        function agregarFila(producto, cantidad, precio, fechavencimiento) {
            if(obtenerFilaConValor("tbProductoCompra", 1, producto)!==-1){
                var tabla = document.getElementById("tbProductoCompra");
                var fila = tabla.getElementsByTagName('tbody')[0].getElementsByTagName('tr')[obtenerFilaConValor("tbProductoCompra", 1, producto)];
                //esta funcion busca si ya existe un producto de ese nombre en la tabla y le modifica algunas cosas
                if (fila) {
                    var celdas = fila.getElementsByTagName('td');

                    celdas[0].innerHTML = '<input type="checkbox">';
                    celdas[1].innerHTML = producto;
                    celdas[2].innerHTML = parseFloat(celdas[2].innerText) + parseFloat(cantidad);
                    celdas[3].innerHTML = 'C$ '+ parseFloat(precio);
                    celdas[4].innerHTML = fechavencimiento;
                    celdas[5].innerHTML = 'C$ '+ ((parseFloat(celdas[2].innerText)*precio).toFixed(2));
                      
                } else {
                    console.error("Fila no encontrada en el índice especificado.");
                }
            }else{
                var tabla = document.getElementById("tbProductoCompra").getElementsByTagName('tbody')[0];
            
                // Crear una nueva fila
                var nuevaFila = tabla.insertRow();

                // Crear nuevas celdas
                var celda0 = nuevaFila.insertCell(0);
                var celda1 = nuevaFila.insertCell(1);
                var celda2 = nuevaFila.insertCell(2);
                var celda3 = nuevaFila.insertCell(3);
                var celda4 = nuevaFila.insertCell(4);
                var celda5 = nuevaFila.insertCell(5);

                // Calcular el total
                var total = cantidad * precio;

                // Agregar contenido a las celdas
                celda0.innerHTML = '<input type="checkbox">';
                celda1.innerHTML = producto;
                celda2.innerHTML = cantidad;
                celda3.innerHTML = 'C$'+precio;
                celda4.innerHTML = fechavencimiento;
                celda5.innerHTML = 'C$'+total.toFixed(2);
            }
        }
        
        function leerTabla() {
            var datosTabla = [];
            var tabla = document.getElementById('tbProductoCompra');
            var filas = tabla.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
            

            for (var i = 0; i < filas.length; i++) {
                var celdas = filas[i].getElementsByTagName('td');
                var filaDatos = {
                    checkbox: celdas[0].querySelector('input[type="checkbox"]').checked,
                    producto: celdas[1].innerText,
                    cantidad: parseFloat(celdas[2].innerText.replace('C$','').trim()),
                    precio: parseFloat(celdas[3].innerText.replace('C$','').trim()),
                    fechavencimiento: celdas[4].innerText,
                    total: parseFloat(celdas[5].innerText.replace('C$','').trim())
                };
                datosTabla.push(filaDatos);
            }

            return datosTabla
        }
        //funcion para conseguir el total
        function ElTotal(datosTabla, columnaIndex) {
            var suma = 0.0;
            var keys = ['checkbox', 'producto', 'cantidad', 'precio', 'vencimiento', 'total'];
            var key = keys[columnaIndex];
            
            for (var i = 0; i < datosTabla.length; i++) {
                var valor = datosTabla[i][key];
                if (!isNaN(valor)) {
                    suma += valor;
                }
            }
            
            return suma;
        }

        function limpiarCadenaNameProv(cadena) {
            // Buscar el índice del primer guion
            var guionIndex = cadena.indexOf('-');
            // Buscar el índice del primer espacio después del guion
            var espacioIndex = cadena.indexOf(' ', guionIndex);
            // Devolver la parte de la cadena después del primer espacio después del guion
            return cadena.substring(espacioIndex + 1);
        }
