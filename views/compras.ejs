            var precioCompra = document.getElementById('precioProducto').value;
            
            // Verificar si los campos están vacíos
            if (cantidadProducto === '' || precioCompra === '' ) {
                alert('Por favor, complete todos los campos antes de agregar el producto.');
                return false; // Impide el envío del formulario
            }else if(parseFloat(cantidadProducto) <=0 || parseFloat(precioCompra) <=0 ){
                alert('solo numeros mayores que 0');
                return false;
            }

            return true; // Permite el envío del formulario
        }

        function verificarOpcion() {
