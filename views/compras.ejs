        function vaciarFilas(namm) {
            // Obtener la referencia a la tabla
            var tabla = document.getElementById(namm);

            // Obtener una referencia a la sección de cuerpo de la tabla
            var tbody = tabla.getElementsByTagName("tbody")[0];

            // Eliminar todas las filas del cuerpo de la tabla
            while (tbody.firstChild) {
                tbody.removeChild(tbody.firstChild);
            }
        }
        document.getElementById('btnTerminarCompra').addEventListener('click', function(){
            var inptProveedor = document.getElementById("txtDocumentoProveedor");
            if(inptProveedor.disabled){

                SubirDatosTabla();

                var boton = document.getElementById("btnTerminarCompra");
                var inptProducto = document.getElementById("cboBuscarProductoCompra");
                var inptPrecio = document.getElementById("precioProducto");
                var inputCantidad = document.getElementById("cantidadAcomprar");
                var inputFechaVencimiento = document.getElementById("FechaVencimiento");
                
                vaciarFilas('tbProductoCompra');

